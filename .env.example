# ════════════════════════════════════════════════════════════════
# KleanVictoria — Environment variables
# Copy to .env.local and fill in real values for development.
# Production values are set in Vercel.
# ════════════════════════════════════════════════════════════════

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://kleanvictoria.com.au

# ── Business identity ──
# These are PLACEHOLDER defaults. The JSON-LD address-gate refuses to emit
# the `address` block in structured data while these match the defaults below.
NEXT_PUBLIC_PHONE=(03) 9000 0000
NEXT_PUBLIC_ADDRESS_STREET=123 Placeholder St
NEXT_PUBLIC_ADDRESS_SUBURB=Melbourne
NEXT_PUBLIC_ADDRESS_POSTCODE=3000
NEXT_PUBLIC_ADDRESS_REGION=VIC
NEXT_PUBLIC_ABN=00 000 000 000

# ── Reviews ──
# Leave unset to suppress AggregateRating JSON-LD emission entirely.
# Set both to numeric values to emit AggregateRating with these fallback numbers
# when GOOGLE_PLACES_API_KEY + GOOGLE_PLACE_ID are not configured.
# NEXT_PUBLIC_REVIEW_COUNT=
# NEXT_PUBLIC_REVIEW_AVERAGE=

# ── Lead intake ──
LEAD_NOTIFY_EMAIL=imtinankhurshid007@gmail.com
RESEND_API_KEY=

# ── Database (Supabase) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Places (optional — live reviews) ──
# When BOTH set, the review stats adapter calls Google Places.
# When EITHER is unset, the adapter falls back to NEXT_PUBLIC_REVIEW_* above.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# ── Analytics ──
# GA4 + Clarity load only after cookie consent. Vercel Analytics is cookieless.
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_CLARITY_ID=
